{
  "about": "The snapshot loader's rules (decision 0011, section 3), one refusing case and at least one passing case for each, decision 0009's rule that every tool not classified `read` says how its `unknown` receipts are settled, and the rules for a profile's exceptions (decision 0011, section 9), named `exception rule a` to `d`. Every case starts from `base`, a proxied entry reaching one project with a read tool declared from its arguments, served to the one team whose limit holds it. `tool`, `entry` and `surface` change fields of the base's first tool, entry and surface (null removes a field); `tools`, `entries`, `surfaces`, `limits` and `profiles` replace the base's. `expect` is `loads`, `does not parse`, or the SnapshotError variant refused with, and `names` lists text the refusal's message must contain. tests/loader_rules.rs runs every case and reports every one that fails.",
  "base": {
    "revision": "rules-1",
    "tools": [
      { "name": "docs-a__list", "classification": "read", "connector": "docs-a", "resources": "declared", "declared_from": "arguments" }
    ],
    "surfaces": [
      { "name": "docs-a", "tools": ["docs-a__list"], "teams": ["team-a"], "principals": "any_in_teams_and_groups" }
    ],
    "profiles": [],
    "limits": {
      "teams": {
        "team-a": [{ "system": "docs", "kind": "project", "identifier": "atlas" }],
        "team-b": [{ "system": "docs", "kind": "project", "identifier": "borealis" }]
      },
      "groups": {
        "engineering": [{ "system": "docs", "kind": "project", "identifier": "atlas" }]
      }
    },
    "entries": [
      {
        "name": "docs-a",
        "kind": "proxied",
        "credential": "team_service_identity",
        "principal": "docs-team-a",
        "narrowing": "none",
        "permits": "read",
        "reach": [{ "system": "docs", "kind": "project", "identifier": "atlas" }],
        "reach_tested_on": "2026-10-12"
      }
    ]
  },
  "cases": [
    { "name": "the base loads", "expect": "loads" },

    {
      "name": "rule 1: a proxied tool declared checks_own_scope is refused",
      "tool": { "resources": "checks_own_scope", "declared_from": null },
      "expect": "ProxiedChecksOwnScope", "names": ["`docs-a__list`", "`docs-a`", "rule 1"]
    },
    {
      "name": "rule 1: a built-in tool may check its own scope",
      "tool": { "resources": "checks_own_scope", "declared_from": null },
      "entry": { "kind": "built_in" },
      "expect": "loads"
    },

    {
      "name": "rule 2: a proxied propose tool is refused",
      "tool": { "classification": "propose" },
      "expect": "ProxiedNotRead", "names": ["`docs-a__list`", "`docs-a`", "`propose`", "rule 2"]
    },
    {
      "name": "rule 2: a proxied write tool is refused",
      "tool": { "classification": "write" },
      "expect": "ProxiedNotRead", "names": ["`docs-a__list`", "`write`"]
    },
    {
      "name": "rule 2: a built-in propose tool served to a team loads",
      "tool": { "classification": "propose", "settlement": "person" },
      "entry": { "kind": "built_in", "permits": "propose" },
      "expect": "loads"
    },

    {
      "name": "rule 3: a proxied entry with a reach and no recorded test is refused",
      "entry": { "reach_tested_on": null },
      "expect": "ReachUntested", "names": ["`docs-a`", "`docs / project / atlas`", "rule 3"]
    },
    {
      "name": "rule 3: a test recorded with something other than a date is no test",
      "entry": { "reach_tested_on": "recently" },
      "expect": "ReachUntested", "names": ["`docs-a`"]
    },
    {
      "name": "rule 3: a proxied entry with no reach at all does not parse",
      "entry": { "reach": null },
      "expect": "does not parse"
    },
    {
      "name": "rule 3: a proxied entry reaching nothing needs no test",
      "tool": { "resources": "no_resources", "declared_from": null },
      "entry": { "reach": [], "reach_tested_on": null },
      "expect": "loads"
    },
    {
      "name": "rule 3: a built-in entry's reach needs no test",
      "entry": { "kind": "built_in", "reach_tested_on": null },
      "expect": "loads"
    },

    {
      "name": "rule 4: a proxied entry whose credential permits more than its read tool is refused",
      "entry": { "permits": "propose" },
      "expect": "PermitsMoreThanTool", "names": ["`docs-a`", "`propose`", "`docs-a__list`", "`read`", "rule 4"]
    },
    {
      "name": "rule 4: a built-in entry's permits is recorded, not compared",
      "entry": { "kind": "built_in", "permits": "write" },
      "expect": "loads"
    },

    {
      "name": "rule 5: one entry reaching both projects, served to both teams, is refused",
      "entry": {
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "surface": { "teams": ["team-a", "team-b"] },
      "expect": "ReachOutsideLimit", "names": ["`docs-a__list`", "`docs-a`", "team `team-a`", "`docs / project / borealis`", "rule 5"]
    },
    {
      "name": "rule 5: a group whose limit lacks part of the reach is refused",
      "entry": {
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "surface": { "teams": [], "groups": ["engineering"] },
      "limits": {
        "teams": {},
        "groups": {
          "engineering": [{ "system": "docs", "kind": "project", "identifier": "atlas" }]
        }
      },
      "expect": "ReachOutsideLimit", "names": ["group `engineering`", "`docs / project / borealis`"]
    },
    {
      "name": "rule 5: a team with no limit at all holds none of the reach",
      "surface": { "teams": ["team-a", "team-c"] },
      "expect": "ReachOutsideLimit", "names": ["team `team-c`", "`docs / project / atlas`"]
    },
    {
      "name": "rule 5: the reach applies on a surface restricted to named principals too",
      "surface": { "teams": ["team-b"], "principals": { "only": [{ "issuer": "https://issuer.example.test", "subject": "one" }] } },
      "expect": "ReachOutsideLimit", "names": ["team `team-b`"]
    },
    {
      "name": "rule 5: a tool declared as the reach on a built-in entry is held to it",
      "tool": { "declared_from": "reach" },
      "entry": {
        "kind": "built_in",
        "narrowing": "limit",
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "expect": "ReachOutsideLimit", "names": ["team `team-a`", "`docs / project / borealis`"]
    },
    {
      "name": "rule 5: an entry narrowed to the caller's limit may reach both projects",
      "entry": {
        "narrowing": "limit",
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "surface": { "teams": ["team-a", "team-b"] },
      "expect": "loads"
    },
    {
      "name": "rule 5: an entry whose reach every admitted limit holds loads",
      "entry": {
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "surface": { "teams": ["team-a", "team-b"] },
      "limits": {
        "teams": {
          "team-a": [
            { "system": "docs", "kind": "project", "identifier": "atlas" },
            { "system": "docs", "kind": "project", "identifier": "borealis" }
          ],
          "team-b": [
            { "system": "docs", "kind": "project", "identifier": "borealis" },
            { "system": "docs", "kind": "project", "identifier": "atlas" }
          ]
        }
      },
      "expect": "loads"
    },
    {
      "name": "rule 5: a tool on no surface is served to nobody",
      "entry": {
        "reach": [
          { "system": "docs", "kind": "project", "identifier": "atlas" },
          { "system": "docs", "kind": "project", "identifier": "borealis" }
        ]
      },
      "surface": { "tools": [], "teams": ["team-a", "team-b"] },
      "expect": "loads"
    },

    {
      "name": "rule 6: a proxied no_resources tool whose entry reaches something is refused",
      "tool": { "resources": "no_resources", "declared_from": null },
      "expect": "NoResourcesWithReach", "names": ["`docs-a__list`", "`docs-a`", "`docs / project / atlas`", "rule 6"]
    },
    {
      "name": "rule 6: a built-in no_resources tool may sit on an entry with a reach",
      "tool": { "resources": "no_resources", "declared_from": null },
      "entry": { "kind": "built_in" },
      "expect": "loads"
    },

    {
      "name": "rule 7: an entry narrowing per call serving a tool that does not say it reads its arguments is refused",
      "tool": { "declared_from": null },
      "entry": { "narrowing": "call" },
      "expect": "CallNarrowingWithoutArguments", "names": ["`docs-a`", "`docs-a__list`", "rule 7"]
    },
    {
      "name": "rule 7: an entry narrowing per call serving a no_resources tool is refused",
      "tool": { "resources": "no_resources", "declared_from": null },
      "entry": { "narrowing": "call", "reach": [], "reach_tested_on": null },
      "expect": "CallNarrowingWithoutArguments", "names": ["`docs-a`", "`docs-a__list`"]
    },
    {
      "name": "rule 7: an entry narrowing per call serving a tool declared from its arguments loads",
      "entry": { "narrowing": "call" },
      "expect": "loads"
    },

    {
      "name": "rule 8: a per-user entry's tool on a surface that admits a team is refused",
      "entry": { "credential": "per_user_grant" },
      "expect": "PerUserToTeam", "names": ["`docs-a__list`", "`docs-a`", "`team-a`", "rule 8"]
    },
    {
      "name": "rule 8: a per-user entry's tool on a surface that admits only groups loads",
      "entry": { "credential": "per_user_grant" },
      "surface": { "teams": [], "groups": ["engineering"] },
      "expect": "loads"
    },

    {
      "name": "rule 9: a propose tool on a surface that admits a group, on a shared entry, is refused",
      "tool": { "classification": "propose" },
      "entry": { "kind": "built_in", "permits": "propose" },
      "surface": { "teams": [], "groups": ["engineering"] },
      "expect": "ProposeToGroup", "names": ["`docs-a__list`", "`docs-a`", "`engineering`", "rule 9"]
    },
    {
      "name": "rule 9: a propose tool on a surface that admits a group, on a per-user entry, loads",
      "tool": { "classification": "propose", "settlement": "person" },
      "entry": { "kind": "built_in", "permits": "propose", "credential": "per_user_grant" },
      "surface": { "teams": [], "groups": ["engineering"] },
      "expect": "loads"
    },
    {
      "name": "rule 9: with no entries, a propose tool on a surface that admits a group is refused: a tool with no entry is not per-user",
      "tool": { "classification": "propose", "resources": "checks_own_scope", "declared_from": null },
      "surface": { "teams": [], "groups": ["engineering"] },
      "entries": [],
      "expect": "ProposeToGroup", "names": ["`docs-a__list`", "`docs-a`", "`engineering`", "rule 9"]
    },
    {
      "name": "rule 9: with no entries, a propose tool on a surface that admits a team and a group is refused",
      "tool": { "classification": "propose", "resources": "checks_own_scope", "declared_from": null },
      "surface": { "groups": ["engineering"] },
      "entries": [],
      "expect": "ProposeToGroup", "names": ["`docs-a__list`", "`engineering`"]
    },
    {
      "name": "rule 9: with no entries, a read tool on a surface that admits a group loads",
      "tool": { "resources": "checks_own_scope", "declared_from": null },
      "surface": { "teams": [], "groups": ["engineering"] },
      "entries": [],
      "expect": "loads"
    },

    {
      "name": "a proxied tool declared as its entry's reach loads, held to rule 5",
      "tool": { "declared_from": "reach" },
      "expect": "loads"
    },
    {
      "name": "a built-in tool declared as its entry's reach loads, held to rule 5",
      "tool": { "declared_from": "reach" },
      "entry": { "kind": "built_in" },
      "expect": "loads"
    },
    {
      "name": "with no entries, a tool declared as the reach is refused: it has no reach to name",
      "tool": { "declared_from": "reach" },
      "entries": [],
      "expect": "ReachWithoutEntry", "names": ["`docs-a__list`", "`docs-a`"]
    },
    {
      "name": "a tool that is not declared cannot say where it is declared from",
      "tool": { "resources": "no_resources" },
      "entry": { "reach": [], "reach_tested_on": null },
      "expect": "DeclaredFromWithoutDeclared", "names": ["`docs-a__list`"]
    },
    {
      "name": "with entries, a tool whose connector has none is refused",
      "tools": [
        { "name": "docs-a__list", "classification": "read", "connector": "docs-a", "resources": "declared", "declared_from": "arguments" },
        { "name": "other__list", "classification": "propose", "connector": "other", "resources": "checks_own_scope" }
      ],
      "expect": "ToolWithoutEntry", "names": ["`other__list`", "`other`"]
    },
    {
      "name": "two entries of one name are refused",
      "entries": [
        { "name": "docs-a", "kind": "proxied", "credential": "team_service_identity", "principal": "docs-team-a", "narrowing": "none", "permits": "read", "reach": [] },
        { "name": "docs-a", "kind": "built_in", "credential": "gateway_token", "principal": "docs-team-a", "narrowing": "none", "permits": "read", "reach": [] }
      ],
      "expect": "DuplicateEntry", "names": ["`docs-a`"]
    },
    {
      "name": "an entry with a field the format does not know does not parse",
      "entry": { "reach_test": "2026-10-12" },
      "expect": "does not parse"
    },
    {
      "name": "an entry with an unknown narrowing does not parse",
      "entry": { "narrowing": "some" },
      "expect": "does not parse"
    },
    {
      "name": "with no entries, as the JSON configuration has, rules 1 to 8 do not apply",
      "tool": { "classification": "propose", "resources": "checks_own_scope", "declared_from": null, "settlement": "person" },
      "entries": [],
      "expect": "loads"
    },

    {
      "name": "settlement: a propose tool that does not say how its unknown receipts are settled is refused",
      "tool": { "classification": "propose" },
      "entry": { "kind": "built_in", "permits": "propose" },
      "expect": "SettlementUndeclared", "names": ["`docs-a__list`", "`propose`", "settlement"]
    },
    {
      "name": "settlement: a write tool that does not say is refused",
      "tool": { "classification": "write" },
      "entry": { "kind": "built_in", "permits": "write" },
      "expect": "SettlementUndeclared", "names": ["`docs-a__list`", "`write`"]
    },
    {
      "name": "settlement: a destructive tool that does not say is refused",
      "tool": { "classification": "destructive" },
      "entry": { "kind": "built_in", "permits": "destructive" },
      "expect": "SettlementUndeclared", "names": ["`docs-a__list`", "`destructive`"]
    },
    {
      "name": "settlement: a propose tool settled by a lookup in a kind of resource loads",
      "tool": { "classification": "propose", "settlement": { "lookup": { "system": "docs", "kind": "project" } } },
      "entry": { "kind": "built_in", "permits": "propose" },
      "expect": "loads"
    },
    {
      "name": "settlement: a write tool settled by a lookup loads",
      "tool": { "classification": "write", "settlement": { "lookup": { "system": "docs", "kind": "project" } } },
      "entry": { "kind": "built_in", "permits": "write" },
      "expect": "loads"
    },
    {
      "name": "settlement: a read tool, which has no receipt, may not declare one",
      "tool": { "settlement": "person" },
      "expect": "SettlementOnRead", "names": ["`docs-a__list`"]
    },
    {
      "name": "settlement: one that is neither a lookup nor a person does not parse",
      "tool": { "classification": "propose", "settlement": "nobody" },
      "entry": { "kind": "built_in", "permits": "propose" },
      "expect": "does not parse"
    },
    {
      "name": "settlement: a lookup that names no kind of resource does not parse",
      "tool": { "classification": "propose", "settlement": { "lookup": { "system": "docs" } } },
      "entry": { "kind": "built_in", "permits": "propose" },
      "expect": "does not parse"
    },

    {
      "name": "exception rule a: an exception on a profile that requires currency loads",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "loads"
    },
    {
      "name": "exception rule a: an exception on a profile that does not require currency is refused",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": false, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptionWithoutCurrency", "names": ["`fenced`", "`comments`", "`docs-a__list`", "currency"]
    },
    {
      "name": "exception rule a: an exception on a profile that does not mention currency is refused",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptionWithoutCurrency", "names": ["`fenced`", "`comments`", "`docs-a__list`"]
    },
    {
      "name": "exception rule a: a profile that does not require currency and lists no exception loads",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": false, "exceptions": []}],
      "expect": "loads"
    },
    {
      "name": "exception rule b: an exception naming an approved write tool loads",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "loads"
    },
    {
      "name": "exception rule b: an exception naming a tool that is not approved is refused",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list", "docs-a__missing"]}]}],
      "expect": "ExceptionToolUnapproved", "names": ["`fenced`", "`comments`", "`docs-a__missing`"]
    },
    {
      "name": "exception rule b: an exception naming a read tool is refused",
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptionToolNotWrite", "names": ["`fenced`", "`comments`", "`docs-a__list`", "`read`"]
    },
    {
      "name": "exception rule b: an exception naming a propose tool is refused",
      "tool": {"classification": "propose", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "propose"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptionToolNotWrite", "names": ["`docs-a__list`", "`propose`"]
    },
    {
      "name": "exception rule b: an exception naming a destructive tool is refused",
      "tool": {"classification": "destructive", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "destructive"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptionToolNotWrite", "names": ["`docs-a__list`", "`destructive`"]
    },
    {
      "name": "exception rule b: Atlassian's proxied addOrEditJiraIssueComment named in an exception is refused: a proxied tool is never write",
      "tools": [{"name": "docs-a__list", "classification": "read", "connector": "docs-a", "resources": "declared", "declared_from": "arguments"}, {"name": "atlassian__addOrEditJiraIssueComment", "classification": "write", "connector": "docs-a", "resources": "declared", "declared_from": "arguments", "settlement": {"lookup": {"system": "docs", "kind": "project"}}}],
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["atlassian__addOrEditJiraIssueComment"]}]}],
      "expect": "ProxiedNotRead", "names": ["`atlassian__addOrEditJiraIssueComment`", "`docs-a`", "rule 2"]
    },
    {
      "name": "exception rule b: Atlassian's proxied addOrEditJiraIssueComment classified read is still refused in an exception",
      "tools": [{"name": "docs-a__list", "classification": "read", "connector": "docs-a", "resources": "declared", "declared_from": "arguments"}, {"name": "atlassian__addOrEditJiraIssueComment", "classification": "read", "connector": "docs-a", "resources": "declared", "declared_from": "arguments"}],
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["atlassian__addOrEditJiraIssueComment"]}]}],
      "expect": "ExceptionToolNotWrite", "names": ["`atlassian__addOrEditJiraIssueComment`", "`read`"]
    },
    {
      "name": "exception rule c: an excepted write tool settled by a lookup loads",
      "tool": {"classification": "write", "settlement": {"lookup": {"system": "docs", "kind": "project"}}},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "loads"
    },
    {
      "name": "exception rule c: an excepted write tool settled by a person is refused",
      "tool": {"classification": "write", "settlement": "person"},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": [{"name": "comments", "tools": ["docs-a__list"]}]}],
      "expect": "ExceptedWriteSettledByPerson", "names": ["`fenced`", "`comments`", "`docs-a__list`", "person"]
    },
    {
      "name": "exception rule c: a write tool settled by a person that no exception names loads",
      "tool": {"classification": "write", "settlement": "person"},
      "entry": {"kind": "built_in", "permits": "write"},
      "profiles": [{"name": "fenced", "classifications": ["read"], "requires_delegation": true, "requires_currency": true, "exceptions": []}],
      "expect": "loads"
    },
    {
      "name": "exception rule d: two exceptions of one profile with their own names and tools load",
